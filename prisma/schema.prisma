generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String            @id @default(cuid())
  email     String            @unique
  name      String
  role      String            @default("ADMIN")
  createdAt DateTime          @default(now())
  mandates  SpendingMandate[]
  approvals Approval[]
}

model SpendingMandate {
  id                     String          @id @default(cuid())
  userId                 String
  name                   String
  naturalLanguage        String
  currency               String
  perTransactionLimit    Decimal         @db.Decimal(12, 2)
  monthlyLimit           Decimal         @db.Decimal(12, 2)
  requireApprovedVendor  Boolean         @default(true)
  duplicateDetection     Boolean         @default(true)
  autoPayEnabled         Boolean         @default(false)
  status                 String          @default("DRAFT")
  createdAt              DateTime        @default(now())
  updatedAt              DateTime        @updatedAt
  user                   User            @relation(fields: [userId], references: [id])
  invoices               Invoice[]
  vendors                ApprovedVendor[]
  @@index([userId, status])
}

model ApprovedVendor {
  id             String          @id @default(cuid())
  mandateId      String
  name           String
  normalizedName String
  email          String?
  paypalEmail    String?
  approved       Boolean         @default(true)
  createdAt      DateTime        @default(now())
  mandate        SpendingMandate @relation(fields: [mandateId], references: [id])
  @@unique([mandateId, normalizedName])
}

model Invoice {
  id               String             @id @default(cuid())
  mandateId        String
  invoiceNumber    String
  vendorName       String
  normalizedVendor String
  vendorEmail      String?
  paypalEmail      String?
  invoiceDate      DateTime?
  dueDate          DateTime?
  amount           Decimal            @db.Decimal(12, 2)
  currency         String
  description      String?
  paymentReference String?
  fileName         String?
  decision         String             @default("PENDING_APPROVAL")
  status           String             @default("REVIEW")
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  mandate          SpendingMandate    @relation(fields: [mandateId], references: [id])
  extraction       InvoiceExtraction?
  evaluation       PolicyEvaluation?
  payment          Payment?
  approvals        Approval[]
  @@unique([mandateId, normalizedVendor, invoiceNumber])
  @@index([decision, status, createdAt])
}

model InvoiceExtraction {
  id           String   @id @default(cuid())
  invoiceId    String   @unique
  source       String
  rawText      String?
  confidence   Float?
  missingFields String[]
  createdAt    DateTime @default(now())
  invoice      Invoice  @relation(fields: [invoiceId], references: [id])
}

model PolicyEvaluation {
  id        String   @id @default(cuid())
  invoiceId String   @unique
  decision  String
  reasons   String[]
  checks    Json
  createdAt DateTime @default(now())
  invoice   Invoice  @relation(fields: [invoiceId], references: [id])
}

model Payment {
  id            String          @id @default(cuid())
  invoiceId     String          @unique
  status        String          @default("AUTHORIZED")
  amount        Decimal         @db.Decimal(12, 2)
  currency      String
  paypalBatchId String?         @unique
  paypalItemId  String?         @unique
  idempotencyKey String         @unique
  initiatedAt   DateTime?
  completedAt   DateTime?
  attempts      PaymentAttempt[]
  invoice       Invoice         @relation(fields: [invoiceId], references: [id])
}

model PaymentAttempt {
  id        String   @id @default(cuid())
  paymentId String
  status    String
  response  Json?
  error     String?
  createdAt DateTime @default(now())
  payment   Payment  @relation(fields: [paymentId], references: [id])
  @@index([paymentId, createdAt])
}

model Approval {
  id        String   @id @default(cuid())
  invoiceId String
  userId    String
  decision  String
  reason    String?
  createdAt DateTime @default(now())
  invoice   Invoice  @relation(fields: [invoiceId], references: [id])
  user      User     @relation(fields: [userId], references: [id])
}

model AuditLog {
  id        String   @id @default(cuid())
  eventType String
  invoiceId String?
  actor     String
  details   Json
  createdAt DateTime @default(now())
  @@index([createdAt, eventType])
}

model WebhookEvent {
  id           String   @id @default(cuid())
  paypalEventId String   @unique
  eventType    String
  payload      Json
  verified     Boolean  @default(false)
  receivedAt   DateTime @default(now())
}
